get SelectedPolygons(){var result=new Array();if(this.SelectedPrimitives){for(var i=0,numberOfPrimitives=this.SelectedPrimitives.length;i<numberOfPrimitives;i++){var primitive=this.SelectedPrimitives[i];result.addRange(primitive.SelectedPolygons,false);}}
return result;}
