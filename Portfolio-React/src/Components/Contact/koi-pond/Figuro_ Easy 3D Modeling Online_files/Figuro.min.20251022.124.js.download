var isFound=false;for(var i=0,numberOfCategories=this.MaterialCategories.Count;i<numberOfCategories;i++){var category=this.MaterialCategories.Get(i);for(var j=0,numberOfMaterials=category.Materials.Count;j<numberOfMaterials;j++){var material=category.Materials.Get(j);if(material.Guid==guid){isFound=true;result=material;break;}}
if(isFound)
break;}
return result;}
GetMaterialCategoryForMaterial(material){var result=null;var isFound=false;for(var i=0,numberOfCategories=this.MaterialCategories.Count;i<numberOfCategories;i++){var category=this.MaterialCategories.Get(i);if(category.Materials.Contains(material)){result=category;break;}}
return result;}
