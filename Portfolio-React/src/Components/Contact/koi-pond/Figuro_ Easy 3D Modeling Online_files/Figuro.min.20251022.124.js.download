EditorPartChangedHandler(property,value){if(property.toUpperCase()==="SELECTEDSCENE"){}
if(property.toUpperCase()==="SELECTEDRENDERMODE"){}
if(property.toUpperCase()==="SELECTEDEDITMODE"){}
if(property.toUpperCase()==="SELECTEDSERVICE"){if(value){let service=value;this.SetToolProperties(service);}}}
SetToolProperties(service){let editMode=Editor.EditorPart.Instance().SelectedEditMode;let viewModel=service.GetViewModel(editMode,RenderViewEnum.Perspective);if(this.ToolProperties!==viewModel){this.ToolProperties=null;this.ToolProperties=viewModel;}}
Render(){this.View.Render();}
AddPerspective(){if(Editor.EditorPart.Instance().SelectedScene)
Client.Global.Instance().EventAggregator.Publish("Menu.AddView",[Editor.EditorPart.Instance().SelectedScene.Guid,RenderViewEnum.Perspective]);}
AddUVEditor(){if(Editor.EditorPart.Instance().SelectedScene)
Client.Global.Instance().EventAggregator.Publish("Menu.AddView",[Editor.EditorPart.Instance().SelectedScene.Guid,RenderViewEnum.UV]);}
SwitchToPerspective(){Client.Global.Instance().EventAggregator.Publish("Canvas.SwitchView",[Editor.EditorPart.Instance().SelectedScene.Guid,this,RenderViewEnum.Perspective]);}
SwitchToUVEditor(){Client.Global.Instance().EventAggregator.Publish("Canvas.SwitchView",[Editor.EditorPart.Instance().SelectedScene.Guid,this,RenderViewEnum.UV]);}
Tile(){Client.Global.Instance().EventAggregator.Publish("Menu.Tile",Editor.EditorPart.Instance().SelectedScene.Guid);}
get CanCut(){let result=false;let scene=Editor.EditorPart.Instance().SelectedScene;let editMode=Editor.EditorPart.Instance().SelectedEditMode;if(scene&&[EditModeEnum.Create,EditModeEnum.Object].contains(editMode)){result=scene.SelectedNodes.length>0;}
return result;}
Cut(){if(this.CanCut)
Editor.EditorPart.Instance().ClipBoard.Cut();else
Messager.Warning("Cut needs a selection of objects.");}
get CanCopy(){let result=false;let scene=Editor.EditorPart.Instance().SelectedScene;let editMode=Editor.EditorPart.Instance().SelectedEditMode;if(scene&&[EditModeEnum.Create,EditModeEnum.Object].contains(editMode)){result=scene.SelectedNodes.length>0;}
return result;}
Copy(){if(this.CanCopy)
Editor.EditorPart.Instance().ClipBoard.Copy();else
Messager.Warning("Copy needs a selection of objects.");}
get CanPaste(){let result=false;let scene=Editor.EditorPart.Instance().SelectedScene;let editMode=Editor.EditorPart.Instance().SelectedEditMode;if(scene&&[EditModeEnum.Create,EditModeEnum.Object].contains(editMode)){result=Editor.EditorPart.Instance().ClipBoard.HasNodes;}
