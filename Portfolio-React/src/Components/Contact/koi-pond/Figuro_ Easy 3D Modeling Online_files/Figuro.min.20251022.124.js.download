else{this.Graph.SelectedPrimitives.forEach((primitive)=>{switch(editMode){case EditModeEnum.Polygon:primitive.SelectAllPolygons();break;case EditModeEnum.Edge:primitive.SelectAllEdges();break;case EditModeEnum.Vertex:primitive.SelectAllVertices();break;case EditModeEnum.UV:primitive.SelectAllUVs();break;}});}
