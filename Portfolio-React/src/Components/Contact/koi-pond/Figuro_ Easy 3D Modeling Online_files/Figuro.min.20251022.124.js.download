static PublishAsset(assetId,galleryName,type,callback){this.Ajax("Publishing asset",{type:"POST",url:this.url+"publishasset",data:{'AssetID':assetId,'GalleryName':galleryName,'Type':type},success:callback});}
static MoveAsset(type,node,callback){switch(type){case 1:this.Ajax("Moving asset",this.GetSettings(node,"moveassettofolder",callback));break;case 3:this.Ajax("Moving asset",this.GetSettings(node,"moveassettocategory",callback));break;}}
static RemoveAsset(node,callback,statusIndicator){this.Ajax("Removing asset",this.GetSettings(node,"removeasset",callback),statusIndicator);}
static MoveFolder(node,callback){this.Ajax("Moving folder",this.GetSettings(node,"movefolder",callback));}
static CreateFolder(node,callback){this.Ajax("Creating folder",this.GetSettings(node,"createfolder",callback));}
static RemoveFolder(node,callback){this.Ajax("Removing folder",this.GetSettings(node,"removefolder",callback));}
static LoadAsset(assetId,scene,isNew,callback,statusIndicator){if(statusIndicator)
statusIndicator.IsBusy=true;var loadedCallback=(scene)=>{callback(scene);};this.Ajax("Retrieving asset",{type:"GET",url:this.url+"getasset",data:{assetID:assetId},success:(asset)=>{this.LoadAssetSceneData(asset,scene,isNew,loadedCallback,statusIndicator);}});}
static LoadAssetSceneData(asset,scene,isNew,callback,statusIndicator){this.Ajax("Loading scene data",{type:"GET",url:this.url+"getassetscenedata/"+asset.ID,responseType:"arraybuffer",dataType:"binary",processData:false,success:(sceneData)=>{try{if(asset.FileType==="DJ"){this.LoadDJFile(asset,sceneData,scene,isNew,callback);}
else if(asset.FileType==="OBJ"){this.LoadOBJFile(asset,sceneData,scene,isNew,callback);}
else{callback(scene);}}
finally{if(statusIndicator)
statusIndicator.IsBusy=false;}}});}
static LoadDJFile(asset,sceneData,scene,isNew,callback){let importer=new Editor.DJ.V1.Import.DJImporter();importer.ImportScene(sceneData,scene,isNew);if(scene.HasMaterials){let materialDataCallback=(materialData)=>{importer.ImportMaterials(materialData,scene);callback(scene);};this.LoadAssetMaterialData(asset.ID,materialDataCallback);}
else
callback(scene);}
static LoadOBJFile(asset,sceneData,scene,isNew,callback){var onDone=()=>{callback(scene);};var onProgress=(progress)=>{};let importer=new Editor.Formats.OBJ.Import.OBJImporter(10,1);importer.ProcessZIPData(sceneData,scene,onDone,onProgress);}
static LoadAssetMaterialData(assetId,callback){this.Ajax("Loading material data",{type:"GET",url:this.url+"getassetmaterialdata/"+assetId,responseType:"arraybuffer",dataType:"binary",processData:false,success:callback});}
static SaveScene(collection,scene,callback,validateCallback,statusIndicator){statusIndicator.IsBusy=true;var exporter=new DJExporter();var sceneData=exporter.ExportScene(scene);var materialData=scene.MaterialsDirty?exporter.ExportMaterials(scene):null;if(!validateCallback(scene,sceneData,materialData)){statusIndicator.IsBusy=false;return;}
this.Ajax("Saving scene",{type:"POST",url:this.url+"saveasset",data:{'ID':scene.Id,'Guid':scene.Guid,'Parent':undefined,'ParentID':collection.Id,'ParentGuid':'','Name':scene.Graph.Root.Name,'NumberOfModels':scene.Graph.NumberOfPrimitives,'NumberOfPolygons':scene.Graph.NumberOfPolygons,'NumberOfVertices':scene.Graph.NumberOfVertices,'NumberOfViews':-1,'LastModified':new Date().toUTCString(),'Children':undefined,'Type':4,'PreviewImage':scene.PreviewImage},success:(node)=>{if(node.FailedValidation){statusIndicator.IsBusy=false;callback(node);return;}
var sceneCallback;if(scene.MaterialsDirty)
sceneCallback=()=>{var materialData=exporter.ExportMaterials(scene);this.SaveMaterialData(node,materialData,callback,statusIndicator);if(callback)
callback(node);statusIndicator.IsBusy=false;};else
sceneCallback=()=>{if(callback)
callback(node);statusIndicator.IsBusy=false;};this.SaveSceneData(node,sceneData,sceneCallback,statusIndicator);}});}
static SaveSceneData(node,sceneData,callback,statusIndicator){this.Ajax("Saving scene data",{type:"PUT",url:this.url+"saveassetscenedata/"+node.ID,data:sceneData,processData:false,success:callback});}
static SaveMaterialData(node,materialData,callback,statusIndicator){this.Ajax("Saving material data",{type:"PUT",url:this.url+"saveassetmaterialdata/"+node.ID,data:materialData,processData:false,success:callback});}
static SavePreview(assetID,imageData){this.Ajax("Uploading preview",{type:"POST",url:this.url+"savepreview",data:{AssetID:assetID,PreviewImage:imageData}});}
static GetPreviewImage(node,callback,statusIndicator=null){this.Ajax("Retrieving preview image",{type:"GET",url:this.url+"getpreviewimage",data:{'AssetID':node.ID},success:callback},statusIndicator);}
static LoadModelPacks(callback,statusIndicator){this.Ajax("Retrieving model packs",{type:"GET",url:this.url+"getmodelpacks",success:callback},statusIndicator);}
static LoadModelPackAssets(modelpackId,callback,statusIndicator){this.Ajax("Retrieving model pack assets",{type:"GET",url:this.url+"getmodelpackassets",data:{modelpackId:modelpackId},success:callback},statusIndicator);}
static LoadCollections(isForMoveRequest,callback,statusIndicator){this.Ajax("Retrieving collections",{type:"GET",url:this.url+"getcollections",data:{isForMoveRequest:isForMoveRequest},success:callback},statusIndicator);}
static LoadCollectionAssets(id,type,callback,statusIndicator){this.Ajax("Retrieving assets",{type:"GET",url:this.url+"getcollectionassets",data:{id:id,type:type},success:callback},statusIndicator);}
static LoadTutorials(callback,statusIndicator){this.Ajax("Retrieving tutorials",{type:"GET",url:this.url+"gettutorials",success:callback},statusIndicator);}
static LoadTutorialLines(id,callback,statusIndicator){this.Ajax("Retrieving tutorial lines",{type:"GET",url:this.url+"gettutoriallines",data:{tutorialID:id},success:callback},statusIndicator);}
static GetSettings(node,method,callback){return{type:"POST",url:this.url+method,data:{'ID':node.ID,'Name':node.Name,'Type':node.Type,'ParentID':node.ParentID,'Parent':undefined,'Children':undefined},success:(node)=>{if(!callback)
return;callback(node);}};}
