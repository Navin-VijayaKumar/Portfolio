this.SelectedCollectionId=null;this.SelectedCollectionId=parent.Guid;scene.Id=node.ID;scene.IsDirty=false;Messager.Information('Your asset was saved.');};}
AssetController.SaveScene(parent,scene,savedCallback,this.ValidateScene,this);}
