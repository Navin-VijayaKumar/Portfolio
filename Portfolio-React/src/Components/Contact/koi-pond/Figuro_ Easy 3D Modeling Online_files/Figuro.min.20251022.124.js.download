OnConstruct(){this.Description="Create tube";}
Move(primitive,position){var center=primitive.Center;var delta=(position.y+(primitive.Height/2))-center.y;var transformation=Matrix.FromTranslation(position.x,delta,position.z);primitive.Vertices.forEach((vertex)=>{vertex.Position=Vector3.Transform(vertex.Position,transformation);});primitive.Update();}
InsertTube(position){var selectedScene=Editor.EditorPart.Instance().SelectedScene;if(!selectedScene)
Messager.Error("Please open a scene first.");else{var onReadPrimitives=(primitives,materials)=>{primitives.forEach((primitive)=>{primitive.DoUpdate();this.tube=primitive;this.tube.SetColour(Colours.GetPaletteColour());this.Move(this.tube,position);this.scene.AddPrimitive(this.tube,null,true);Editor.EditorPart.Instance().Render();});};var onProgress=(progress)=>this.Progress(progress);var importer=new Client.Parts.Editor.Formats.OBJ.Import.OBJImporter(1,1);importer.ReadOBJ(this.tubeDefinition,null,onProgress,onReadPrimitives);}}
Progress(progress){};Create(position){this.InsertTube(position);}
GetRandomNumber(min,max){return Math.random()*(max-min)+min;}
Undo(){this.scene.RemoveItem(this.tube);}
Redo(){this.scene.AddPrimitive(this.tube,null,false);}}
Operations.TubeCreator=TubeCreator;})(Operations=Tube.Operations||(Tube.Operations={}));})(Tube=Items.Tube||(Items.Tube={}));})(Items=Editor.Items||(Editor.Items={}));})(Editor=Parts.Editor||(Parts.Editor={}));})(Parts=Client.Parts||(Client.Parts={}));})(Client||(Client={}));var Client;(function(Client){var Parts;(function(Parts){var Editor;(function(Editor){var Items;(function(Items){var Tube;(function(Tube){class TubeService extends Client.Parts.Editor.Types.ServiceBase{constructor(){super();this.Type=ServiceTypeEnum.Tube;this.ShortLabel="tube";this.ToolTip="create a tube.";this.RequiresPRO=true;}
GetViewModel(editMode,renderView){if(!this.viewModel)
this.viewModel=new Client.Parts.Editor.Items.Tube.ViewModels.TubeOptionsViewModel();return this.viewModel;}
OnMouseInput(mouseState){if(mouseState.Action===CanvasActionEnum.None||mouseState.Action===CanvasActionEnum.SpecialCase)
return;switch(mouseState.EventArgs.Event){case MouseEventEnum.Down:break;case MouseEventEnum.Move:break;case MouseEventEnum.Up:this.Create(mouseState);break;}}
Create(mouseState){var scene=Editor.EditorPart.Instance().SelectedScene;let itemSelector=new ItemSelector();let items=[];itemSelector.SelectFromGraph(scene.Graph.Root,mouseState.Camera,mouseState.X,mouseState.Y,false,items);let doAdd=false;if(items.length==0){doAdd=true;}
else{let sortedItems=items.sort((a,b)=>{return a.Distance-b.Distance;});let item=sortedItems[0].Node;doAdd=true;}
if(doAdd){let selector=new PolygonSelector();let primitives=scene.Graph.Primitives;let selection=selector.SelectByRayFromPrimitives(mouseState.X,mouseState.Y,mouseState.Camera,primitives);let position;if(selection.Polygon)
