return;this.RemoveGraphNode(node);if(triggerEvents){this.TriggerSceneChanged();this.TriggerSelectionChanged();}}
RemoveItems(items){for(var i=0,len=items.length;i<len;i++)
this.RemoveItem(items[i],false);this.TriggerSceneChanged();this.TriggerSelectionChanged();}
AddItem(item){if(item instanceof Types.Primitive)
this.AddPrimitive(item,null,false);if(item instanceof Types.PointLight)
this.AddPointLight(item,false);}
AddItems(items){for(var i=0,len=items.length;i<len;i++){var item=items[i];this.AddItem(item);}}
