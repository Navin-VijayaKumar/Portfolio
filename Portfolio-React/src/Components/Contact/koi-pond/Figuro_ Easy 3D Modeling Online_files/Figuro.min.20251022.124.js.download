PreRender(node){if(node instanceof PrimitiveNode){var primitive=node.Primitive;if(primitive.IsDirty){primitive.DoUpdate();node.IsDirty=true;}}
for(var i=0;i<node.Children.length;i++){var child=node.Children[i];this.PreRender(child);}}
Render(){this.PreRender(this.scene.Graph.Root);for(var i=0,numberOfRenderables=this.Renderables.Count;i<numberOfRenderables;i++){var renderable=this.Renderables.Items[i];renderable.Render();}
this.PostRender(this.scene.Graph.Root);}
PostRender(node){if(node instanceof PrimitiveNode){if(node.IsDirty){node.IsDirty=false;}}
for(var i=0;i<node.Children.length;i++){var child=node.Children[i];this.PostRender(child);}}
Refresh(){this.scene.Graph.MakeDirty();}}
