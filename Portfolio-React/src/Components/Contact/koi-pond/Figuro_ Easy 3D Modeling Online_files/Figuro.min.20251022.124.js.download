Update(){var maxValue=Number.MAX_VALUE;var minValue=-maxValue;this.min.x=maxValue;this.min.y=maxValue;this.min.z=maxValue;this.max.x=minValue;this.max.y=minValue;this.max.z=minValue;for(var i=0,numberOfVertices=this.Vertices.length;i<numberOfVertices;i++){var item=this.Vertices[i];if(item.x<this.Min.x)
