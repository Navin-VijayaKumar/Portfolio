OnNodeChanged(property,value){if(property==="IsVisible"||property==="IsLocked"){}}
TriggerSelectionChanged(){$(this).trigger("OnSelectionChanged");}
AddGraphNodeToSelection(node,clearSelection=false){if(clearSelection)
this.ClearSelection(false);if(this.SelectedNodes.contains(node)){node.IsSelected=false;this.SelectedNodes.remove(node);}
else{node.IsSelected=true;this.SelectedNodes.push(node);}
this.TriggerSelectionChanged();}
AddGraphNodesToSelection(nodes,clearSelection=false){if(clearSelection)
this.ClearSelection(false);nodes.forEach((node)=>{if(this.SelectedNodes.contains(node)){node.IsSelected=false;this.SelectedNodes.remove(node);}
