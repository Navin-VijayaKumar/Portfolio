var collection=this.SelectedCollection;if(scene.Id==-1&&(collection.Type!==1||collection.Group.toUpperCase()==="PREFABS"))
collection=this.Collections.first();var beforeSave=()=>this.BeforeSave(collection,scene,renameScene);if(scene.PreviewImage==null){this.TakeScreenshot(scene,null,null,beforeSave);}
else
beforeSave();}
