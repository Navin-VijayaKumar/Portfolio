AddPolygonsToSelection(primitive,polygons,handleUVs=false){polygons.forEach((polygon)=>{if(primitive.SelectedPolygons.contains(polygon)){primitive.SelectedPolygons.remove(polygon);if(handleUVs){for(var i=0,numberOfUVs=polygon.UVs.length;i<numberOfUVs;i++)
primitive.SelectedUVs.remove(polygon.UVs[i]);}}
else{primitive.SelectedPolygons.push(polygon);if(handleUVs)
primitive.SelectedUVs.addRange(polygon.UVs,false);}});$(this).trigger("OnSelectionChanged");}
RemovePolygonFromSelection(primitive,polygon,handleUVs=false){primitive.SelectedPolygons.remove(polygon);if(handleUVs){for(var i=0,numberOfUVs=polygon.UVs.length;i<numberOfUVs;i++)
primitive.SelectedUVs.remove(polygon.UVs[i]);}
$(this).trigger("OnSelectionChanged");}
AddEdgeToSelection(primitive,edge){if(!primitive.SelectedEdges.contains(edge)){primitive.SelectedEdges.push(edge);$(this).trigger("OnSelectionChanged");}}
AddEdgesToSelection(primitive,edges){primitive.SelectedEdges.addRange(edges,false);$(this).trigger("OnSelectionChanged");}
AddVertexToSelection(primitive,vertex){if(!primitive.SelectedVertices.contains(vertex)){primitive.SelectedVertices.push(vertex);$(this).trigger("OnSelectionChanged");}}
AddVerticesToSelection(primitive,vertices){primitive.SelectedVertices.addRange(vertices,false);$(this).trigger("OnSelectionChanged");}
RemoveEdgeFromSelection(primitive,edge){primitive.SelectedEdges.remove(edge);$(this).trigger("OnSelectionChanged");}
RemoveVertexFromSelection(primitive,vertex){primitive.SelectedVertices.remove(vertex);$(this).trigger("OnSelectionChanged");}
AddUVToSelection(primitive,uv){primitive.SelectedUVs.push(uv);$(this).trigger("OnSelectionChanged");}
AddUVsToSelection(primitive,uv){primitive.SelectedUVs.addRange(uv,false);$(this).trigger("OnSelectionChanged");}
