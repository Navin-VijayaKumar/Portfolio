if(this.localKeyboard.IsDown(Keyboard.RIGHT)){flipFactor=-1;this.deltaPanX=flipFactor*this.movementSpeed;shouldUpdate=true;}
if(this.localKeyboard.IsDown(Keyboard.PLUS))
if(this.movementSpeed<1024)
this.movementSpeed++;if(this.localKeyboard.IsDown(Keyboard.MINUS))
if(this.movementSpeed>1)
this.movementSpeed--;if(this.globalKeyboard.IsDown(Keyboard.SHIFT)){if(!this.isShiftDown)
