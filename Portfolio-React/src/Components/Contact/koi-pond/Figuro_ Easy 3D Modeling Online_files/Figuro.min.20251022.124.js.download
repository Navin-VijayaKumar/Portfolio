DeleteFolder(){var collection=this.SelectedCollection;if(collection.Description=="Personal"){Messager.Warning("Cannot delete the Personal folder.");return;}
if(collection.Type!==1){Messager.Warning("Cannot delete gallery categories.");return;}
if(collection.Group.toUpperCase()==="PREFABS"){Messager.Warning("Cannot delete prefab folders.");return;}
$.messager.confirm('Please confirm','Are you sure you want to delete the folder and all its content?',(reply)=>{if(!reply)
