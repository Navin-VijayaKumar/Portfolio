var node=new Client.Parts.Editor.Types.Node(undefined,selectedAsset.Name);node.ID=selectedAsset.Id;node.Guid=selectedAsset.Guid;node.Type=4;node.ParentID=-1;AssetController.RemoveAsset(node,()=>{var scene=Editor.EditorPart.Instance().Scenes.Items.filter(e=>e.Id==selectedAsset.Id).first();if(scene)
