EditorPartChangedHandler(property,value){if(property.toUpperCase()==="SELECTEDSCENE"){this.SetSelectedScene(value);}
if(property.toUpperCase()==="SELECTEDRENDERMODE"){this.SetRenderMode(value);}
if(property.toUpperCase()==="SELECTEDEDITMODE"){this.SetEditMode(value);}
if(property.toUpperCase()==="SELECTEDSERVICE"){if(value)
this.SetSelectedService(value.Type);}}
SetSelectedScene(value){if(this.scene){EventManager.Unregister(this,this.scene,"OnSelectionChanged");}
this.scene=value;EventManager.Register(this,this.scene,"OnSelectionChanged",(e)=>this.SelectionChangedHandler());if(!this.scene)
this.UpdateDescriptions(null,null);else{this.UpdateDescriptions(this.scene.UndoRedoManager.GetCurrentUndo(),this.scene.UndoRedoManager.GetCurrentRedo());}}
SelectionChangedHandler(){if(!this.scene)
return;if(this.scene.SelectedNodes.length===0)
this.SetCreateMode();else{if(this.CreateModeSelected||this.ObjectModeSelected)
this.SetEditMode(EditModeEnum.Object);}}
OnUndoRedoManagerHandler(operations){this.UpdateDescriptions(operations[0],operations[1]);}
UpdateDescriptions(undoTool,redoTool){if(undoTool)
this.UndoDescription="Undo "+undoTool.Description.toLowerCase();else
this.UndoDescription=this.noUndo;if(redoTool)
this.RedoDescription="Redo "+redoTool.Description.toLowerCase();else
this.RedoDescription=this.noRedo;}
SetRenderMode(value){this.WireframeModeSelected=value===RenderModeEnum.Wireframe;this.SolidColourModeSelected=value===RenderModeEnum.SolidColour;this.TexturedModeSelected=value===RenderModeEnum.Textured;Editor.EditorPart.Instance().SetSelectedRenderMode(value);}
SelectWireFrameMode(){this.SetRenderMode(RenderModeEnum.Wireframe);}
SelectSolidColourMode(){this.SetRenderMode(RenderModeEnum.SolidColour);}
SelectTexturedMode(){this.SetRenderMode(RenderModeEnum.Textured);}
New(){Client.Global.Instance().EventAggregator.Publish("Editor.New");}
Save(){Client.Global.Instance().EventAggregator.Publish("Editor.Save");}
CanSave(){var value=Client.Global.Instance().IsLoggedIn&&this.scene!==undefined;return value;}
SaveAs(){Client.Global.Instance().EventAggregator.Publish("Editor.SaveAs");}
CanSaveAs(){var value=Client.Global.Instance().IsLoggedIn&&this.scene!==undefined;return value;}
Undo(){var scene=Editor.EditorPart.Instance().SelectedScene;if(scene)
scene.UndoRedoManager.Undo();}
CanUndo(){return this.UndoDescription!==this.noUndo;}
Redo(){var scene=Editor.EditorPart.Instance().SelectedScene;if(scene)
scene.UndoRedoManager.Redo();}
CanRedo(){return this.RedoDescription!==this.noRedo;}
Cut(){Editor.EditorPart.Instance().ClipBoard.Cut();}
CanCut(){return Editor.EditorPart.Instance().SelectedEditMode===EditModeEnum.Object;}
Copy(){Editor.EditorPart.Instance().ClipBoard.Copy();}
CanCopy(){return Editor.EditorPart.Instance().SelectedEditMode===EditModeEnum.Object;}
Paste(){Editor.EditorPart.Instance().ClipBoard.Paste();}
CanPaste(){return Editor.EditorPart.Instance().SelectedEditMode===EditModeEnum.Object;}
ImportOBJ(){var scene=Editor.EditorPart.Instance().SelectedScene;if(!scene)
return;var viewModel=new Client.Parts.Editor.Formats.OBJ.Import.OBJViewModel(scene);viewModel.Show();}
ImportSTL(){var scene=Editor.EditorPart.Instance().SelectedScene;if(!scene)
return;var viewModel=new Client.Parts.Editor.Formats.STL.Import.STLImporterViewModel(scene);viewModel.Show();}
ImportGLB(){var scene=Editor.EditorPart.Instance().SelectedScene;if(!scene)
return;var viewModel=new Client.Parts.Editor.Formats.GLB.Import.GLBImporterViewModel(scene);viewModel.Show();}
ImportDPS(){var scene=Editor.EditorPart.Instance().SelectedScene;if(!scene)
return;var viewModel=new Client.Parts.Editor.Formats.DPS.Import.DPSViewModel(scene);viewModel.Show();}
ExportOBJ(){var scene=Editor.EditorPart.Instance().SelectedScene;if(!scene)
return;let isAuthorized=Client.Global.Instance().IsLoggedIn;if(!isAuthorized){Messager.Warning("You need an account to export scenes.");}
else{let limits=Client.Global.Instance().Profile.Limits;let maxNumberOfExports=limits.Exports;AccountController.GetCurrentNumberOfExports((numberOfExports)=>{if(maxNumberOfExports==-1||numberOfExports<=maxNumberOfExports){var exporter=new Client.Parts.Editor.Formats.OBJ.Export.OBJExporter();exporter.Export(scene);}
else{Messager.Warning("You have reached the maximum amount of exports for this day. You need a paid account to remove this restriction.");}},this);}}
ExportSTL(){var scene=Editor.EditorPart.Instance().SelectedScene;if(!scene)
return;let isAuthorized=Client.Global.Instance().IsLoggedIn;if(!isAuthorized){Messager.Warning("You need an account to export scenes.");}
else{let limits=Client.Global.Instance().Profile.Limits;let maxNumberOfExports=limits.Exports;AccountController.GetCurrentNumberOfExports((numberOfExports)=>{if(maxNumberOfExports==-1||numberOfExports<=maxNumberOfExports){var viewModel=new Client.Parts.Editor.Formats.STL.Export.STLExporterViewModel(scene);viewModel.Show();}
else{Messager.Warning("You have reached the maximum amount of exports for this day. You need a paid account to remove this restriction.");}},this);}}
ExportRTS(){var scene=Editor.EditorPart.Instance().SelectedScene;if(!scene)
return;var exporter=new Client.Parts.Editor.Formats.RTS.Export.RTSExporter();exporter.Export(scene);}
ShowSettings(){var viewModel=new Client.Parts.Editor.ViewModels.SettingsViewModel();viewModel.Show();}
SetEditMode(editMode){if(this.editMode===editMode)
return;this.editMode=editMode;this.CreateModeSelected=this.editMode===EditModeEnum.Create;this.ObjectModeSelected=this.editMode===EditModeEnum.Object;this.PolygonModeSelected=this.editMode===EditModeEnum.Polygon;this.EdgeModeSelected=this.editMode===EditModeEnum.Edge;this.VertexModeSelected=this.editMode===EditModeEnum.Vertex;this.UVModeSelected=this.editMode==EditModeEnum.UV;Editor.EditorPart.Instance().SetSelectedEditMode(editMode);if(this.CreateModeSelected){this.SetSelectedService(this.currentItemService);}
else{var selectedService=this.serviceManager.GetService(this.currentToolService);if(!selectedService.Supports(this.editMode))
this.SetSelectedService(ServiceTypeEnum.Move);else
this.SetSelectedService(this.currentToolService);}}
SetCreateMode(){this.SetEditMode(EditModeEnum.Create);}
CanSetObjectMode(){return this.CanEdit();}
SetObjectMode(){this.SetEditMode(EditModeEnum.Object);}
SetPolygonMode(){this.SetEditMode(EditModeEnum.Polygon);}
CanEdit(){if(!this.scene)
return false;else
return this.scene.SelectedNodes.length>0;}
CanSetPolygonMode(){return this.CanEdit();}
SetEdgeMode(){this.SetEditMode(EditModeEnum.Edge);}
CanSetEdgeMode(){return this.CanEdit();}
SetVertexMode(){this.SetEditMode(EditModeEnum.Vertex);}
CanSetVertexMode(){return this.CanEdit();}
SetUVMode(){this.SetEditMode(EditModeEnum.UV);}
CanSetUVMode(){return this.CanEdit();}
SetSelectedService(serviceType){Editor.EditorPart.Instance().SetSelectedService(serviceType);if(Editor.EditorPart.Instance().IsCreationServiceEx(serviceType)){this.currentItemService=null;this.currentItemService=serviceType;}
else{this.currentToolService=null;this.currentToolService=serviceType;}}
ImportMyMiniFactory(){var viewModel=new Client.Parts.Editor.Integrations.MyMiniFactory.MyMiniFactoryViewModel(this.scene);viewModel.Show();}
ImportGooglePoly(){var viewModel=new Client.Parts.Editor.Integrations.GooglePoly.GooglePolyViewModel(this.scene);viewModel.Show();}
ValidateAssetForPublishing(scene){if(!this.IsLoggedIn)
return"Please login to publish your scene.";if(scene.Id==-1)
return"Please save your scene first.";if(scene.Graph.NumberOfPrimitives==0)
return"Please add some geometry to your scene.";if(Client.Global.Instance().Profile.MemberLengthInDays<=3)
return"You need to be a member for at least 3 days before publishing.";return"";}
PublishAsset(galleryName,type){let selectedScene=Editor.EditorPart.Instance().SelectedScene;let errorMessage=this.ValidateAssetForPublishing(selectedScene);if(errorMessage.length>0){Messager.Warning(errorMessage);return;}
Messager.Confirm("Please confirm","Do you really want to PUBLISH your scene to the gallery? If not, SAVE your scene instead.",(value)=>{if(!value)
return;AssetController.PublishAsset(selectedScene.Id,galleryName,type,()=>{Client.Global.Instance().EventAggregator.Publish("Asset.Publish");Messager.Information("Your scene was published.");});});}
PublishTechnology(){this.PublishAsset("technology",3);}
PublishVehicles(){this.PublishAsset("vehicles",3);}
PublishAnimals(){this.PublishAsset("animals",3);}
PublishArchitecture(){this.PublishAsset("architecture",3);}
PublishPlantTrees(){this.PublishAsset("plants & trees",3);}
PublishFurniture(){this.PublishAsset("furniture",3);}
PublishWeapons(){this.PublishAsset("weapons",3);}
PublishCharacters(){this.PublishAsset("characters",3);}
PublishVarious(){this.PublishAsset("various",3);}
Unpublish(){this.PublishAsset("personal",1);}}
